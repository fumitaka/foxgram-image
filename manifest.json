{
  "manifest_version": 3,
  "name": "Foxgram Image",
  "version": "1.0.2",
  "description": "Simple Firefox extension for saving Instagram images.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxgram-image@fumitaka",
      "strict_min_version": "115.0",
      "update_url": "https://raw.githubusercontent.com/fumitaka/foxgram-image/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
